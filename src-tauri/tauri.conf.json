{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "betterRGB",
  "version": "0.1.0",
  "identifier": "com.betterrgb.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "betterRGB — Smart Asus RGB Controller",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../bin/**/*"
    ]
  }
}